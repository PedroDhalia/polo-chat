# Copie este arquivo para .env (cp .env.example .env). Nunca coloque chaves aqui.

# Banco local do MVP (SQLite). Para PostgreSQL: altere o provider em prisma/schema.prisma
# e use, por exemplo, DATABASE_URL="postgresql://user:pass@localhost:5432/platano_ops"
DATABASE_URL="file:./dev.db"

# Modo das integrações: "mock" (único disponível no MVP).
INTEGRATIONS_MODE="mock"

# Segunda opinião da IA: "mock" (simulada, sem custo) ou "live" (API da Anthropic).
ASSIST_AI_MODE="mock"
# Modelo usado no modo "live" (padrão: claude-opus-5-5).
# ASSIST_AI_MODEL="claude-opus-5-5"

# A chave da API vai em .env.local (ignorado pelo Git), nunca neste arquivo:
# ANTHROPIC_API_KEY="sk-ant-..."
